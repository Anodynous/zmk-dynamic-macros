#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>
#include <behaviors/dynamic_macro.dtsi>
#include <dt-bindings/zmk/dynamic_macros.h>

/*
 * Preview event coverage: PREVIEW_PROMPT on mode entry, then PREVIEW_READY (with
 * the slot index) once a slot is chosen — the signal a widget waits on before
 * calling dm_get_preview_string(). Records A into slot 0, enters preview mode,
 * then selects slot 0.
 *
 * PERSIST=n forces NVS_SLOTS=0, so DM_SLOT_RAM 0 is machine slot 0. FEEDBACK_OFF
 * so the only stream is the dm_event notifications.
 *
 * Key layout (3 rows x 2 cols):
 *   (0,0)=REC        (0,1)=STP
 *   (1,0)=RAM slot 0 (1,1)=RAM slot 1
 *   (2,0)=A          (2,1)=PREVIEW
 */

&kscan {
    rows = <3>;
    columns = <2>;
    exit-after;
    events = <
        /* REC A -> assign slot 0 */
        ZMK_MOCK_PRESS(0,0,10)
        ZMK_MOCK_RELEASE(0,0,10)
        ZMK_MOCK_PRESS(2,0,10)
        ZMK_MOCK_RELEASE(2,0,10)
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_PRESS(1,0,10)
        ZMK_MOCK_RELEASE(1,0,10)
        /* PREVIEW -> select slot 0 */
        ZMK_MOCK_PRESS(2,1,10)
        ZMK_MOCK_RELEASE(2,1,10)
        ZMK_MOCK_PRESS(1,0,10)
        ZMK_MOCK_RELEASE(1,0,10)
    >;
};

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &dm DM_REC 0      &dm DM_STP 0
                &dm DM_SLOT_RAM 0 &dm DM_SLOT_RAM 1
                &kp A             &dm DM_PREVIEW 0
            >;
        };
    };
};
