#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>
#include <behaviors/dynamic_macro.dtsi>
#include <dt-bindings/zmk/dynamic_macros.h>

/*
 * Move full-flow event coverage: MOVE_PROMPT ->
 * MOVE_SRC_SELECTED (slot = src) -> MOVED (slot = dst, slot2 = src). Records one
 * event into RAM slot 0, assigns it, enters move mode, selects slot 0 as source,
 * then moves it to the empty slot 1.
 *
 * PERSIST=n forces NVS_SLOTS=0, so DM_SLOT_RAM 0/1 are machine slots 0/1 and the
 * event slot fields read 0/1. FEEDBACK_OFF so the only stream is the dm_event
 * notifications (which fire at every feedback level).
 *
 * Key layout (3 rows x 2 cols):
 *   (0,0)=REC        (0,1)=STP
 *   (1,0)=RAM slot 0 (1,1)=RAM slot 1
 *   (2,0)=A          (2,1)=MOV
 */

&kscan {
    rows = <3>;
    columns = <2>;
    exit-after;
    events = <
        /* REC */
        ZMK_MOCK_PRESS(0,0,10)
        ZMK_MOCK_RELEASE(0,0,10)
        /* A (recorded) */
        ZMK_MOCK_PRESS(2,0,10)
        ZMK_MOCK_RELEASE(2,0,10)
        /* STP -> assign-pending */
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,10)
        /* RAM slot 0 (assign) */
        ZMK_MOCK_PRESS(1,0,10)
        ZMK_MOCK_RELEASE(1,0,10)
        /* MOV (enter move mode) */
        ZMK_MOCK_PRESS(2,1,10)
        ZMK_MOCK_RELEASE(2,1,10)
        /* RAM slot 0 (select source) */
        ZMK_MOCK_PRESS(1,0,10)
        ZMK_MOCK_RELEASE(1,0,10)
        /* RAM slot 1 (destination, empty) -> move */
        ZMK_MOCK_PRESS(1,1,10)
        ZMK_MOCK_RELEASE(1,1,10)
    >;
};

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &dm DM_REC 0      &dm DM_STP 0
                &dm DM_SLOT_RAM 0 &dm DM_SLOT_RAM 1
                &kp A             &dm DM_MOV 0
            >;
        };
    };
};
