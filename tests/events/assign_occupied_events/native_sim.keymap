#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>
#include <behaviors/dynamic_macro.dtsi>
#include <dt-bindings/zmk/dynamic_macros.h>

/*
 * Assign-to-occupied event coverage: assigning a fresh recording to a slot that
 * is already in use raises ERROR_SLOT_OCCUPIED and stays in assign-pending (state
 * remains ASSIGN_PENDING), so the user can pick another slot. Records A into slot
 * 0, records B, targets occupied slot 0 (rejected), then assigns B to empty slot 1.
 *
 * PERSIST=n forces NVS_SLOTS=0, so DM_SLOT_RAM 0/1 are machine slots 0/1.
 * FEEDBACK_OFF so the only stream is the dm_event notifications.
 *
 * Key layout (3 rows x 2 cols):
 *   (0,0)=REC        (0,1)=STP
 *   (1,0)=RAM slot 0 (1,1)=RAM slot 1
 *   (2,0)=A          (2,1)=B
 */

&kscan {
    rows = <3>;
    columns = <2>;
    exit-after;
    events = <
        /* REC A -> assign slot 0 */
        ZMK_MOCK_PRESS(0,0,10)
        ZMK_MOCK_RELEASE(0,0,10)
        ZMK_MOCK_PRESS(2,0,10)
        ZMK_MOCK_RELEASE(2,0,10)
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_PRESS(1,0,10)
        ZMK_MOCK_RELEASE(1,0,10)
        /* REC B -> stop */
        ZMK_MOCK_PRESS(0,0,10)
        ZMK_MOCK_RELEASE(0,0,10)
        ZMK_MOCK_PRESS(2,1,10)
        ZMK_MOCK_RELEASE(2,1,10)
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,10)
        /* target occupied slot 0 (rejected), then empty slot 1 (saved) */
        ZMK_MOCK_PRESS(1,0,10)
        ZMK_MOCK_RELEASE(1,0,10)
        ZMK_MOCK_PRESS(1,1,10)
        ZMK_MOCK_RELEASE(1,1,10)
    >;
};

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &dm DM_REC 0      &dm DM_STP 0
                &dm DM_SLOT_RAM 0 &dm DM_SLOT_RAM 1
                &kp A             &kp B
            >;
        };
    };
};
